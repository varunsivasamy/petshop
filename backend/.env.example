# Environment Variables Example for PetShop Backend

# Secret Key (Set your own secure random key in production)
SECRET_KEY=django-insecure-petshop-enterprise-key-production-ready-#solid-arch
DEBUG=True

# Database Configuration
# Options: 'sqlite3' (default, zero configuration), 'postgresql', 'mysql'
DB_ENGINE=sqlite3

# If using PostgreSQL:
# DB_ENGINE=postgresql
# DB_NAME=petshop_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# If using MySQL:
# DB_ENGINE=mysql
# DB_NAME=petshop_db
# DB_USER=root
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=3306
